# Comma-separated exact frontend origins. No paths or wildcard hosts.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional writable PDF cache directory; default is finn-backend/data/research.
# RESEARCH_CACHE_DIR=E:/enam_holding/finn-backend/data/research
# PostgreSQL: supply your own credentials locally. Hosted URLs may include sslmode=require.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_SCHEMA=public
# Persistent filesystem root in production; do not use an ephemeral disk.
# DOCUMENT_STORAGE_DIR=E:/enam_holding/finn-backend/data/documents
DOCUMENT_CACHE_HOURS=24
DOCUMENT_RETENTION_DAYS=30
RESEARCH_PROVIDER=extractive
# Optional OpenAI-compatible structured evidence selector (not arbitrary prose).
# RESEARCH_LLM_URL=https://your-provider.example/v1/chat/completions
# RESEARCH_LLM_MODEL=your-model
# RESEARCH_LLM_API_KEY=
